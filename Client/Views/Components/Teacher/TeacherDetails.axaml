<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Client.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Client.Views.Components.Teacher.TeacherDetails"
             x:DataType="vm:TeachersViewModel">

  <Grid RowDefinitions="Auto,*,Auto" RowSpacing="24">
    <Grid Grid.Row="0" ColumnDefinitions="*, Auto">
      <StackPanel Grid.Column="0" Spacing="6">
        <TextBlock  Classes="sectionTitle" Text="{Binding DetailsTitle}" />
        <TextBlock  Classes="secondaryText" Text="{Binding DetailsDescription}" />
      </StackPanel>
      <TextBlock Grid.Column="1" Classes="bodyText" Text="{Binding SelectedTeacher.SocialSecurityNumber}" />
    </Grid>

    <Grid
      Grid.Row="1"
      ColumnDefinitions="*, *"
      RowDefinitions="Auto,Auto,Auto"
      ColumnSpacing="30"
      RowSpacing="20"
      >
      <StackPanel Grid.Row="0" Grid.Column="0" Spacing="6">
        <TextBlock Classes="secondaryText" Text="Förnamn" />
        <TextBlock Classes="bodyText" Text="{Binding SelectedTeacher.FirstName}" />
      </StackPanel>
      <StackPanel Grid.Row="0" Grid.Column="1" Spacing="6">
        <TextBlock Classes="secondaryText" Text="Efternamn" />
        <TextBlock Classes="bodyText" Text="{Binding SelectedTeacher.LastName}" />
      </StackPanel>
      <StackPanel Grid.Row="1" Grid.Column="0" Spacing="6">
        <TextBlock Classes="secondaryText" Text="Telefonnummer" />
        <TextBlock Classes="bodyText" Text="{Binding SelectedTeacher.PhoneNumber}" />
      </StackPanel>
      <StackPanel Grid.Row="1" Grid.Column="1" Spacing="6">
        <TextBlock Classes="secondaryText" Text="Personnummer" />
        <TextBlock Classes="bodyText" Text="{Binding SelectedTeacher.SocialSecurityNumber}" />
      </StackPanel>
      <StackPanel Grid.Row="2" Grid.Column="0" Spacing="6">
        <TextBlock Classes="secondaryText" Text="Adress" />
        <TextBlock Classes="bodyText" Text="{Binding SelectedTeacher.Address}" />
      </StackPanel>
      <StackPanel Grid.Row="2" Grid.Column="1" Spacing="6">
        <TextBlock Classes="secondaryText" Text="Kunskapsområde" />
        <TextBlock Classes="bodyText" Text="{Binding SelectedTeacher.FieldOfKnowledge}" />
      </StackPanel>
    </Grid>
    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
      <Button Classes="secondary" Command="{Binding ToListCommand}">
        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <PathIcon Data="{StaticResource BackIcon}" Width="16" Height="16" />
          <TextBlock Text="Tillbaka" />
        </StackPanel>
      </Button>
      <Button Classes="primary" Command="{Binding ShowEditFormCommand}">
        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <PathIcon Data="{StaticResource EditIcon}" Width="16" Height="16" />
          <TextBlock Text="Redigera" />
        </StackPanel>
      </Button>
    </StackPanel>
  </Grid>

  <!-- <StackPanel>
  <TextBlock Text="Lärarinformation" />
