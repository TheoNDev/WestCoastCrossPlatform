<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Add Resources Here -->
  <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F5F7FB" />
  <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#FFFFFF" />
  <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
  <SolidColorBrush x:Key="InputBackgroundBrush" Color="#FFFFFF" />
  <SolidColorBrush x:Key="PrimaryTextBrush" Color="#0F172A" />
  <SolidColorBrush x:Key="SecondaryTextBrush" Color="#64748B" />
  <SolidColorBrush x:Key="BorderBrush" Color="#E2E8F0" />
  <SolidColorBrush x:Key="AccentBrush" Color="#2563EB" />
  <SolidColorBrush x:Key="AccentHoverBrush" Color="#1D4ED8" />
  <SolidColorBrush x:Key="SelectedNavigationBrush" Color="#EFF6FF" />
  <SolidColorBrush x:Key="DangerBrush" Color="#DC2626" />
  <SolidColorBrush x:Key="SuccessBrush" Color="#16A34A" />
</ResourceDictionary>
