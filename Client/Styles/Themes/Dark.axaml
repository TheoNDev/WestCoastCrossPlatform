<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Add Resources Here -->
  <SolidColorBrush x:Key="AppBackgroundBrush" Color="#0F172A" />
  <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#111C30" />
  <SolidColorBrush x:Key="SurfaceBrush" Color="#1E293B" />
  <SolidColorBrush x:Key="InputBackgroundBrush" Color="#253247" />
  <SolidColorBrush x:Key="PrimaryTextBrush" Color="#F8FAFC" />
  <SolidColorBrush x:Key="SecondaryTextBrush" Color="#94A3B8" />
  <SolidColorBrush x:Key="BorderBrush" Color="#334155" />
  <SolidColorBrush x:Key="AccentBrush" Color="#3B82F6" />
  <SolidColorBrush x:Key="AccentHoverBrush" Color="#2563EB" />
  <SolidColorBrush x:Key="SelectedNavigationBrush" Color="#1E3A5F" />
  <SolidColorBrush x:Key="DangerBrush" Color="#EF4444" />
  <SolidColorBrush x:Key="SuccessBrush" Color="#22C55E" />
</ResourceDictionary>
